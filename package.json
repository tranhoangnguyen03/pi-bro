{
  "name": "pi-bro",
  "version": "0.22.1",
  "description": "A sidekick for you and your Pi agent: plain-language explanations, side questions, diagrams, PR review and second opinions, without cluttering the agent's context.",
  "type": "module",
  "license": "MIT",
  "author": "Tran Hoang Nguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tranhoangnguyen03/pi-bro.git"
  },
  "homepage": "https://github.com/tranhoangnguyen03/pi-bro#readme",
  "bugs": {
    "url": "https://github.com/tranhoangnguyen03/pi-bro/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "document",
    "webpage",
    "article",
    "pdf",
    "docx",
    "simplify",
    "agy",
    "gemini",
    "tui",
    "diagram",
    "show",
    "btw",
    "side-conversation",
    "advisor",
    "second-opinion",
    "codex",
    "muse",
    "coding-agent",
    "ai-agents",
    "cli",
    "developer-tools",
    "code-review"
  ],
  "files": [
    "bro.ts",
    "review.ts",
    "review-source.ts",
    "review-ui.ts",
    "review-modal.ts",
    "util.ts",
    "settings.ts",
    "sources.ts",
    "config-ui.ts",
    "ui-capabilities.ts",
    "backend.ts",
    "prompt.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/user-guide.md",
    "docs/pig-compatibility.md",
    "docs/guided-review.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node .github/scripts/release-utils.mjs selftest && node --test test/review-ux.test.mjs test/review-doctor.test.mjs test/review-versions.test.mjs test/review-regeneration.test.mjs test/review-modal.test.mjs test/review.test.ts test/review-ui.test.mjs test/review-session.test.mjs test/helpers.test.mjs test/prompt.test.ts test/backend.test.ts test/claude.test.ts test/grok.test.ts test/codex.test.ts test/muse.test.ts test/settings.test.ts test/sources.test.ts test/release.test.ts test/show-html.test.ts test/smoke-rpc.test.ts test/ui-capabilities.test.ts benchmark/*.test.ts && sh ./test/smoke-test.sh",
    "benchmark:dry-run": "node benchmark/run.ts dry-run",
    "benchmark:run": "node benchmark/run.ts run",
    "benchmark:report": "node benchmark/run.ts report",
    "prepublishOnly": "npm test"
  },
  "pi": {
    "extensions": [
      "./bro.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^24.0.0",
    "typebox": "1.3.7",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "defuddle": "0.19.4",
    "linkedom": "0.18.13",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1"
  }
}
